<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="path/to/your/custom/styles.css"> <!-- Diğer stil dosyalarınızı ekleyin -->
</head>
<body>
    <div class="sidebar">
        <div class="scrollbar-inner sidebar-wrapper">
            <div class="user">
                <div class="photo">
                    <img src="~/Ready-Bootstrap-Dashboard-master/assets/img/profile.jpg">
                </div>
                <div class="info">
                    <a class="" data-toggle="collapse" href="#collapseExample" aria-expanded="true">
                        <span>
                            Ömer Adiyaman
                            <span class="user-level">Admin</span>
                            <span class="caret"></span>
                        </span>
                    </a>
                    <div class="clearfix"></div>
                    <div class="collapse in" id="collapseExample" aria-expanded="true" style="">
                        <ul class="nav">
                            <li>
                                <a href="#profile">
                                    <span class="link-collapse">Profilim</span>
                                </a>
                            </li>
                            <li>
                                <a href="#edit">
                                    <span class="link-collapse">Şifre Değiştir</span>
                                </a>
                            </li>
                            <li>
                                <a href="#settings">
                                    <span class="link-collapse">Ayarlar</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <ul class="nav">
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-tachometer-alt"></i>
                        <p>Ana Sayfa</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Default/Index">
                        <i class="la la-home"></i>
                        <p>Siteye Git</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-user"></i>
                        <p>Hakkımda</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/ToDoList/Index">
                        <i class="fas fa-list-ul"></i>
                        <p>Yapılacaklar</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-briefcase"></i>
                        <p>Deneyimler</p>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-star"></i>
                        <p>Öne Çıkan Alan</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-envelope"></i>
                        <p>İletişim Bilgileri</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-file-alt"></i>
                        <p>Portfolyo</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-cogs"></i>
                        <p>Yeteneklerim</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-thumbs-up"></i>
                        <p>Referanslarım</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-share-alt"></i>
                        <p>Sosyal Medya</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Message/Inbox">
                        <i class="fa fa-inbox"></i>
                        <p>Gelen Kutusu</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Statistic/Index">
                        <i class="fa fa-chart-bar"></i>
                        <p>İstatistikler</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Experience/ExperienceList/">
                        <i class="fa fa-sign-out-alt"></i>
                        <p>Çıkış Yap</p>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</body>
</html>
