@model List<Portfolio.Dal.Entities.Skill>
@{
    int x = 0;
}
<div class="col-six tab-full right">
    <h3>Programlama Dilleri & Teknolojiler</h3>

    <ul class="skill-bars">
        @foreach (var item in Model)
        {
            x = item.Value;
            <li>
                <div class="progress" style="width: @x%;"><span>@item.Value%</span></div>
                <strong>@item.SkillTitle</strong>
            </li>
        }
    </ul>
</div>